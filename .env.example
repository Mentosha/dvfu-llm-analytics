# Скопируй файл в .env и заполни значениями.
# .env находится в .gitignore — НЕ коммить его.

# --- Google Gemini ---
# Получить: https://aistudio.google.com/apikey (через VPN)
GEMINI_API_KEY=AIza...

# Модели по умолчанию (можно менять без правки кода)
BOT_AGENT_MODEL=gemini-2.5-flash
BOT_GUARD_MODEL=gemini-2.5-flash-lite
PIPELINE_MODEL=gemini-2.5-flash-lite

# --- Telegram ---
# Получить у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# --- SOCKS5 / HTTP прокси для обхода RU-блокировки Gemini ---
# Формат: socks5://user:pass@host:port  или  http://user:pass@host:port
LLM_PROXY_URL=

# (необязательно) отдельный прокси для Telegram API.
# Если пусто — aiogram использует LLM_PROXY_URL.
# Telegram заблокирован в РФ → на сервере в РФ обязательно нужен прокси.
TELEGRAM_PROXY_URL=

# --- Прочее ---
# Пусто = бот доступен всем. Иначе — список Telegram user_id через запятую.
ALLOWED_USERS=

LOG_LEVEL=INFO

# Лимиты
MAX_FILE_SIZE_MB=10
MAX_INSTRUCTION_CHARS=1000
RATE_LIMIT_PER_HOUR=3
